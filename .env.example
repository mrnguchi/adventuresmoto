# Next.js and Prisma use this connection for normal application queries.
# Production: comma-separated public site origins, without paths.
# Set in Hostinger to https://adventuresmoto.com,https://www.adventuresmoto.com
APP_ORIGINS=""
DATABASE_URL="mysql://adventuresmoto:replace-with-a-local-password@127.0.0.1:3307/adventuresmoto"

# Prisma uses an isolated database while validating development migrations.
SHADOW_DATABASE_URL="mysql://adventuresmoto:replace-with-a-local-password@127.0.0.1:3307/adventuresmoto_shadow"

# These values initialize the local MariaDB container.
MARIADB_DATABASE="adventuresmoto"
MARIADB_USER="adventuresmoto"
MARIADB_PASSWORD="replace-with-a-local-password"
MARIADB_ROOT_PASSWORD="replace-with-a-different-local-root-password"

# Order notifications: keep disabled until real SMTP settings are configured.
SMTP_ENABLED="false"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
ORDER_EMAIL_TO=""
